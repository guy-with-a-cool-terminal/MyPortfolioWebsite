# None of these are secrets — they're public *.workers.dev URLs and a mode
# string. Copy to .env (gitignored) to override locally, or set in Vercel's
# project env config for prod. Omitting any of these falls back to the
# defaults baked into the source (see src/lib/progressDataSource.ts,
# src/utils/chatClient.ts, src/utils/notionClient.ts).

# 'worker' (canonical, paginates properly) | 'local' (fallback, computed in the
# browser from notion-proxy's raw list — see src/lib/progressDataSource.ts for
# the pagination caveat). Flip to 'worker' once notion-chat is deployed; that's
# the entire migration.
VITE_STATS_SOURCE=local

VITE_NOTION_PROXY_URL=https://notion-proxy.njugunabriian-dev.workers.dev
VITE_NOTION_CHAT_URL=https://notion-chat.njugunabriian-dev.workers.dev
